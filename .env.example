# Groq API; required for full-text and audio translation.
# Create a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_AUDIO_MODEL=whisper-large-v3-turbo

# Safety / limits
# No hard word limit. Documents are processed in model-sized chunks.
MAX_WORDS=0
REQUEST_TIMEOUT=120
RATE_LIMIT_PER_MINUTE=20

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
