# Gemini Developer API free tier; required for full-text, file, and audio translation.
# Create a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional xAI fallback provider.
# Get a key: https://console.x.ai
XAI_API_KEY=

# OpenAI-compatible base URL (do not change unless you know you need to)
XAI_BASE_URL=https://api.x.ai/v1

# Default model. Confirm current names at https://docs.x.ai/developers/models
XAI_MODEL=grok-4.5

# Safety / limits
# No hard word limit. Documents are processed in model-sized chunks.
MAX_WORDS=0
REQUEST_TIMEOUT=120
RATE_LIMIT_PER_MINUTE=20

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
